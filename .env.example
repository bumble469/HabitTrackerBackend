# Copy this file to .env and fill in the values. Never commit .env.

# Neon Postgres connection string, e.g.
# postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
# If left empty, a local SQLite file (dev.db) is used so you can start right away.
DATABASE_URL=

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Secret that signs login tokens. Use a long random value, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# How long a login lasts, in minutes (10080 = 7 days)
JWT_EXPIRE_MINUTES=10080
